# Android Release Signing Configuration Template
# Copy this file to keystore.properties and fill in your values
# NEVER commit keystore.properties with real secrets to version control

# Path to keystore file (relative to project root or absolute)
storeFilePath=keystore.jks

# Keystore password
storePassword=YOUR_KEYSTORE_PASSWORD

# Key alias name
keyAlias=YOUR_KEY_ALIAS

# Key password
keyPassword=YOUR_KEY_PASSWORD
